# Exemplo: /etc/nginx/sites-available/cataloghdd
# Ajuste server_name, certificados, paths e socket do PHP-FPM ao seu ambiente.
server {
    listen 443 ssl http2;
    server_name catalog.example.com;

    root /opt/cataloghdd/web/public;
    index index.php;
    client_max_body_size 8m;

    ssl_certificate /etc/letsencrypt/live/catalog.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/catalog.example.com/privkey.pem;

    location = /catalog {
        return 301 /catalog/;
    }

    location ^~ /catalog/ {
        try_files $uri $uri/ /catalog/index.php?$query_string;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; img-src 'self' data:; script-src 'self'; style-src 'self'; connect-src 'self'; object-src 'none'" always;

        location ~ \.php$ {
            include snippets/fastcgi-php.conf;
            fastcgi_pass unix:/run/php/php-fpm.sock;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_param HTTP_PROXY "";
            # Necessário para que os tokens Bearer da API cheguem ao PHP.
            fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        }

        location ~* \.(?:css|js|jpg|jpeg|png|webp|gif|ico)$ {
            expires 7d;
            add_header Cache-Control "public, max-age=604800, immutable";
            try_files $uri =404;
        }
    }

    location ~ ^/catalog/(?:app|bin|migrations|docs|config|\.git|\.env) {
        deny all;
    }
}
